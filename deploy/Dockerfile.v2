# The one Pim v2 image. It runs one role per container, chosen by the command: `migrate`, `gate`, `live`, `runner`, `forge`, `canvas`,
# `relay`, `maintenance` or `all-in-one` (deploy/compose/compose.yaml and deploy/k8s/ set `command: [<role>]` and PIM_IMAGE to this image).
#
#   docker build -f deploy/Dockerfile.v2 -t registry.example.test/pim:2.0.0 .
#
# The version and the commit this image was built from are build arguments (the publishing workflow passes `--build-arg PIM_VERSION=<X.Y.Z, or edge> --build-arg PIM_REVISION=<full commit>`):
# the running Pim reads them from its environment and shows them in Settings → Deployment, and they are the image's `org.opencontainers.image.version` and `.revision` labels, which
# the update check reads from the registry. A local build without them is `dev` at an unknown revision, which is never offered an update.
#
# The sources run under tsx, which keeps every package's own paths (its migrations, its SQL) where the code expects them; there is no bundle.
# The image carries no web app: that is its own image (deploy/Dockerfile.web), served by the web host, so the interface and the backend are released separately.
FROM node:26-bookworm-slim AS build

# Node 26 no longer ships corepack; pnpm is the version package.json pins.
RUN npm install -g pnpm@12.0.0
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches ./patches
COPY web/package.json ./web/
COPY packages/coding/package.json ./packages/coding/
COPY packages/shared/package.json ./packages/shared/
COPY packages/triggers/package.json ./packages/triggers/
COPY packages/ui-lang/package.json ./packages/ui-lang/
COPY packages/v2-app/package.json ./packages/v2-app/
COPY packages/v2-contracts/package.json ./packages/v2-contracts/
COPY packages/v2-forge/package.json ./packages/v2-forge/
COPY packages/v2-live/package.json ./packages/v2-live/
COPY packages/v2-ops/package.json ./packages/v2-ops/
COPY packages/v2-runtime/package.json ./packages/v2-runtime/
COPY packages/v2-server/package.json ./packages/v2-server/
# Only the v2 server and what it imports are installed, production dependencies only.
RUN pnpm install --frozen-lockfile --prod --filter "@pim/v2-server..."
COPY packages ./packages

FROM node:26-bookworm-slim
ARG PIM_VERSION=dev
ARG PIM_REVISION=unknown
LABEL org.opencontainers.image.version=$PIM_VERSION org.opencontainers.image.revision=$PIM_REVISION
ENV NODE_ENV=production PIM_VERSION=$PIM_VERSION PIM_REVISION=$PIM_REVISION
WORKDIR /app/packages/v2-server
COPY --from=build /app /app
# pim-computer, pim-host and the triggers runtime: the Gate serves them (/pim-computer.ts, /pim-host.ts, /triggers-host.ts, ...; machines update themselves from them), and the `local-computer` profile and a container host run them.
COPY computer /app/computer
# displayd's files, which the Gate serves as /displayd.tar.gz for a computer to get displayd from the same Pim (displayd/bundle.js).
COPY displayd/package.json displayd/bundle.js /app/displayd/
COPY displayd/src /app/displayd/src
# The folder a computer's files are mounted on, owned by `node`: a new volume takes the owner this folder has in the image.
RUN mkdir -p /workspace && chown node:node /workspace
# The roles listen on PIM_HTTP_PORT (8080) and PIM_METRICS_PORT (9464); the filesystem is read-only in both deployments, and /tmp is a tmpfs.
USER node
EXPOSE 8080 9464
ENTRYPOINT ["node", "--import", "tsx", "src/main.ts"]
