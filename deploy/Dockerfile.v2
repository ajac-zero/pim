# The one Pim v2 image. It runs one role per container, chosen by the command: `migrate`, `gate`, `live`, `runner`, `forge`, `canvas`,
# `relay`, `maintenance` or `all-in-one` (deploy/compose/compose.yaml and deploy/k8s/ set `command: [<role>]` and PIM_IMAGE to this image).
#
#   docker build -f deploy/Dockerfile.v2 -t registry.example.test/pim:2.0.0 .
#
# The sources run under tsx, which keeps every package's own paths (its migrations, its SQL) where the code expects them; there is no bundle.
# The web app (web/) is built in its own stage and served by the Gate from PIM_WEB_DIR (packages/v2-server/src/web-assets.ts).
FROM node:26-bookworm-slim AS web

# Node 26 no longer ships corepack; pnpm is the version package.json pins.
RUN npm install -g pnpm@12.0.0
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches ./patches
COPY packages ./packages
# The web build reads the computer's sources (web/vite.config.ts).
COPY web ./web
COPY computer ./computer
COPY displayd ./displayd
RUN pnpm install --frozen-lockfile --filter "pim-web..." && pnpm --filter pim-web build

FROM node:26-bookworm-slim AS build

# Node 26 no longer ships corepack; pnpm is the version package.json pins.
RUN npm install -g pnpm@12.0.0
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches ./patches
COPY packages ./packages
# Only the v2 server and what it imports are installed, production dependencies only.
RUN pnpm install --frozen-lockfile --prod --filter "@pim/v2-server..."

FROM node:26-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app/packages/v2-server
COPY --from=build /app /app
COPY --from=web /app/web/dist /app/web/dist
# pim-computer, pim-host and the triggers runtime: the Gate serves them (/pim-computer.ts, /pim-host.ts, /triggers-host.ts, ...; machines update themselves from them), and the `local-computer` profile and a container host run them.
COPY computer /app/computer
# The folder a computer's files are mounted on, owned by `node`: a new volume takes the owner this folder has in the image.
RUN mkdir -p /workspace && chown node:node /workspace
ENV PIM_WEB_DIR=/app/web/dist
# The roles listen on PIM_HTTP_PORT (8080) and PIM_METRICS_PORT (9464); the filesystem is read-only in both deployments, and /tmp is a tmpfs.
USER node
EXPOSE 8080 9464
ENTRYPOINT ["node", "--import", "tsx", "src/main.ts"]
