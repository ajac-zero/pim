# The celld node's settings: copy to /etc/celld/celld.env, owned by root, `chmod 600`. The
# systemd unit reads it, and deploy.sh --celld-env reads the bucket settings from it. The bucket
# credentials control the whole fleet, every person's data and the deployment's secrets with it:
# give them access to this one bucket only. Never commit the copy.

# The fleet bucket, and a prefix of its own. It must be a store celld qualifies: Amazon S3,
# Cloudflare R2, Google Cloud Storage, Tigris or Azure Blob Storage (https://celld.dev/docs,
# "Configure object storage"). MinIO, Backblaze B2, Hetzner and DigitalOcean Spaces are not.
CELLD_BUCKET=s3://YOUR-BUCKET/pim
# Cloudflare R2 as the example; for Amazon S3 leave S3_ENDPOINT out and set the bucket's region.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Both listeners on loopback: only the TLS proxy on this machine reaches the Worker, and nothing
# but this machine reaches the peer and operator API, which has no authentication. With the
# proxy on another machine, use this machine's private (WireGuard, Tailscale) address for
# CELLD_ADDR instead, never a public one, and keep CELLD_INTERNAL_ADDR on loopback.
CELLD_ADDR=127.0.0.1:8080
CELLD_INTERNAL_ADDR=127.0.0.1:8081

# The proxy replaces X-Forwarded-Host and X-Forwarded-Proto on every request, so celld may
# trust them: Pim then sees https://pim.example.com, the address it answers at.
CELLD_TRUST_FORWARDED_HEADERS=1

# One node has no peer to hold a write, so every write waits for the bucket either way; say so.
CELLD_DURABILITY=bucket

# The node's local working copy of the databases. Not a backup: the bucket is the data.
CELLD_WATCH=/var/lib/celld/state
CELLD_ASSET_CACHE_DIR=/var/lib/celld/assets

# Unset, celld never deletes the history a cell writes on each activation, so the bucket keeps
# growing. Setting it is an operator decision (https://celld.dev/docs/guarantees, "Epoch GC").
# CELLD_LTX_RETENTION_SECS=604800
