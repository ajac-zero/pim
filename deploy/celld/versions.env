# The toolchain a celld build of Pim is made and run with. Each pin is a release and the
# SHA-256 of its download, from the release's own asset digests on GitHub; the scripts here
# refuse anything else. Node.js (.nvmrc), pnpm (package.json's packageManager) and every npm
# package, esbuild among them (pnpm-lock.yaml), are pinned where the rest of Pim pins them.
#
# Changing celld: read its upgrade notes (https://celld.dev/docs#upgrade-notes) between the
# two versions first, then update all four lines below from
#   gh release view <tag> --repo denoland/celld --json assets --jq '.assets[] | "\(.name) \(.digest)"'
# and run deploy/celld/test/run-scratch.sh against the new binary before any real node.

CELLD_VERSION=v0.6.3
# The commit v0.6.3 is tagged at, which its build attestation names.
CELLD_COMMIT=8702f6d186c77698dbfb30cf29e3b1922a88f008
CELLD_SHA256_x86_64_unknown_linux_gnu=5084a083472cf036551a7eac63fa24d22bb9a56323c517f63205724c12783047
CELLD_SHA256_aarch64_unknown_linux_gnu=6d617cdf9f049e43ca6a4e37c4cce5d8e35395c8e86b371c984d32ba7d803bf5
CELLD_SHA256_aarch64_apple_darwin=2df6b08369345db8c1f9a5edcf3932cecaa6fb35f4658575a6db17df28c22371

# The TLS proxy in caddy/Caddyfile, and the one the proxy check runs.
CADDY_VERSION=v2.11.7
CADDY_SHA256_linux_amd64=727b91701a392de6ebc5027509f548bf39979e5216340d0faed8fa5e69c84f8b
CADDY_SHA256_linux_arm64=d8fc6d179a5d283028a472a5618564f6ad8a86fed513e64f032b3b0b7cc45e42
