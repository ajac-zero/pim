# Copy to .env and replace every CHANGE_ME with a value from `openssl rand -base64 32` (or a URL-safe equivalent for passwords).
# This file is the only place secrets live for a Compose deployment; keep .env out of version control and back it up with the key backup.

PIM_IMAGE=registry.example.test/pim:2.0.0
PIM_DOMAIN=pim.example.test
PIM_PUBLIC_URL=https://pim.example.test
PIM_CONTENT_DOMAIN=content.pim.example.test
PIM_CONTENT_ORIGIN=https://content.pim.example.test
PIM_APPS_DOMAIN=apps.pim.example.test
PIM_APPS_ORIGIN=https://apps.pim.example.test
PIM_ACME_EMAIL=ops@example.test

# PostgreSQL roles. Passwords are URL-safe (no @ : / ?).
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
PIM_MIGRATOR_DB_PASSWORD=CHANGE_ME
PIM_GATE_DB_PASSWORD=CHANGE_ME
PIM_RUNTIME_DB_PASSWORD=CHANGE_ME
PIM_LIVE_DB_PASSWORD=CHANGE_ME
PIM_FORGE_DB_PASSWORD=CHANGE_ME
PIM_MAINTENANCE_DB_PASSWORD=CHANGE_ME
PGBOUNCER_AUTH_PASSWORD=CHANGE_ME

# Shared secret between the proxy and the roles: at least 32 characters, different from every key above.
PIM_INGRESS_SECRET=CHANGE_ME

# S3-compatible object storage (SeaweedFS in this stack).
SEAWEED_ACCESS_KEY=CHANGE_ME
SEAWEED_SECRET_KEY=CHANGE_ME
PIM_S3_BUCKET=pim-objects

# Envelope-encryption key-encryption key: 32 random bytes, base64. Rotate by adding PIM_KEK_k2, setting PIM_KEK_CURRENT=k2 and keeping k1 until everything is rewrapped.
PIM_KEK_CURRENT=k1
PIM_KEK_K1=CHANGE_ME

# Web Push (device alerts): the deployment's VAPID key pair, made by init-env.sh, base64url (the 65-byte public point and the 32-byte private scalar). Keep them with
# the backups and never change them: every browser that turned notifications on is bound to the public key and would stop receiving alerts. Empty turns push off.
# PIM_VAPID_SUBJECT is who the push service may contact (a mailto: address or https URL; default PIM_PUBLIC_URL).
PIM_VAPID_PUBLIC_KEY=
PIM_VAPID_PRIVATE_KEY=
PIM_VAPID_SUBJECT=
# Development only: allow plain-http and private-address push endpoints, for a stand-in push service. Leave 0.
PIM_PUSH_ALLOW_PRIVATE=0

# Optional: traces. Prompts and tool bodies are never exported unless the next line is true, and credentials never are.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Optional profiles.
TURN_SHARED_SECRET=CHANGE_ME
PIM_CODING_MANAGER_TOKEN=CHANGE_ME
PIM_ALLOWED_SANDBOX_IMAGES=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Optional: pim-computer on this machine (profile local-computer). Pair a computer in Settings → Computer first; its token is shown once.
PIM_COMPUTER_URL=
PIM_COMPUTER_TOKEN=

# Optional: connectors (docs/architecture/v2-connectors.md). A native connector is offered once its OAuth client is set; each redirect URI is $PIM_PUBLIC_URL/mcp/callback/apps.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Homelab: let connectors live at private addresses, and servers use plain http.
PIM_CONNECTOR_ALLOW_PRIVATE=
