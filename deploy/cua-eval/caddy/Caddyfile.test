# A stand-in for the Cua evaluation VM's Caddyfile, for test_caddy.py: the same kind of site
# (HTTP Basic for the person, the viewer's RPC allowlist to spacesd) with pim-bridge's routes and
# log filters imported as the docs say. Plain HTTP on loopback; TLS changes nothing tested here.
{
	admin off
	auto_https off
	log default {
		output file {$PIM_TEST_LOGS}/default.log
		format filter {
			wrap json
			fields {
				import pim-bridge-log-fields.caddy
			}
		}
		level DEBUG
	}
}

http://127.0.0.1:{$PIM_TEST_PORT} {
	log {
		output file {$PIM_TEST_LOGS}/access.log
		format filter {
			wrap json
			fields {
				import pim-bridge-log-fields.caddy
			}
		}
	}

	import pim-bridge-routes.caddy

	@viewer_rpc {
		method POST
		path /cua.env.v1.SystemService/GetCapabilities /cua.env.v1.StreamService/ListTargets /cua.env.v1.StreamService/CloseMedia
	}
	handle @viewer_rpc {
		reverse_proxy {$PIM_TEST_SPACESD}
	}
	handle /viewer/* {
		basic_auth {
			person $2a$14$pgxHN7F8uLoaxR3NI2yyt.iVQZWo6cjrhZR3lZ5VGGPr/dxjdndiq
		}
		respond "viewer" 200
	}
	handle {
		respond 404
	}
}
