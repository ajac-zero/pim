# What the bridge never receives: the site's Basic login, cookies, and headers that claim where
# a request came from or which page sent it (the bridge trusts none of them, and logs none).
header_up -Authorization
header_up -Cookie
header_up -Proxy-Authorization
header_up -Forwarded
header_up -X-Forwarded-For
header_up -X-Forwarded-Proto
header_up -X-Forwarded-Host
header_up -X-Forwarded-Port
header_up -X-Forwarded-Prefix
header_up -X-Real-IP
header_up -X-Client-IP
header_up -CF-Connecting-IP
header_up -True-Client-IP
header_up -Origin
header_up -Referer
