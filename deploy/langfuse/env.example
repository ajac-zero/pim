# What deploy/langfuse/.env holds, as init-env.sh writes it. Do not copy this file: run ./init-env.sh, which fills every value with a random one.
# The address people open Langfuse at (NEXTAUTH_URL): change it with LANGFUSE_BIND and a TLS proxy in front when it is not this machine.
LANGFUSE_URL=http://localhost:3100
LANGFUSE_BIND=127.0.0.1
LANGFUSE_PORT=3100
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
LANGFUSE_POSTGRES_PASSWORD=CHANGE_ME
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE_ME
LANGFUSE_REDIS_PASSWORD=CHANGE_ME
LANGFUSE_MINIO_PASSWORD=CHANGE_ME
LANGFUSE_ADMIN_EMAIL=admin@pim.invalid
LANGFUSE_ADMIN_PASSWORD=CHANGE_ME
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
