{
  "name": "pim",
  "version": "0.1.0",
  "description": "An open-source personal agent, with its web app, deployable to Cloudflare Durable Objects.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "type": "module",
  "cloudflare": {
    "bindings": {
      "PIM_PUBLIC_URL": {
        "description": "The address people will use, such as `https://pim.example.com`. Pim answers only there, and passkeys belong to it. For the Worker's own address, enter `https://<Worker name>.<your subdomain>.workers.dev`; your subdomain is on the Workers & Pages overview. A custom domain must also be attached to the Worker after deploying."
      }
    }
  },
  "scripts": {
    "dev": "wrangler dev --var PIM_PUBLIC_URL:http://localhost:8787",
    "dev:web": "pnpm --filter pim-web dev",
    "build": "pnpm --filter pim-web build",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev --local --config wrangler.preview.jsonc --persist-to .wrangler/state-preview",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit && pnpm --filter pim-web typecheck",
    "lint": "pnpm --filter pim-web lint",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run && pnpm --filter pim-web test",
    "test:live": "PIM_LIVE=1 vitest run"
  },
  "dependencies": {
    "@cloudflare/computer": "0.5.1",
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "agents": "0.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
