{
  "name": "@pim/core",
  "version": "0.1.0",
  "description": "Pim v2's portable core: the PostgreSQL pi-durable storage, ownership and activation, the command inbox, live replay, authorization, secrets, and the role-selectable processes. Depends on @pim/shared and never on the Worker.",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/main.ts src/migrate/cli.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outdir=dist --out-extension:.js=.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.1.0",
    "@pim/shared": "workspace:*",
    "pg": "^8.13.1",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0"
  }
}
