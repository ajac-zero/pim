// The fence Worker's configuration, written by hand. It is the legacy Worker's, as it was at the git tag `v1-final`, with the same name, compatibility date, Durable Object bindings and
// classes, migrations, containers, R2 buckets, KV namespace and version metadata, so that the shell binds the namespaces the legacy Worker left; only `main` differs, and what an inert
// Worker has no use for (static assets, Workers AI, rate limits, the web build, preview settings) is left out. Nothing is deleted from the namespaces: no `deleted_classes`, no
// `exports` tombstone, and the migrations array is the legacy one unchanged. Change a name, a tag or a class only to match what is deployed (test/fence.test.ts checks it is consistent).
{
	"name": "pim",
	"main": "./index.ts",
	"compatibility_date": "2026-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "Pim",
				"class_name": "Pim"
			},
			{
				"name": "Auth",
				"class_name": "Auth"
			},
			{
				"name": "Directory",
				"class_name": "Directory"
			},
			{
				"name": "Gallery",
				"class_name": "Gallery"
			},
			{
				"name": "CodingScheduler",
				"class_name": "CodingSchedulerDO"
			},
			{
				"name": "CodingThread",
				"class_name": "CodingThreadDO"
			},
			{
				"name": "HostOps",
				"class_name": "HostOps"
			},
			{
				"name": "WorkspaceContainer",
				"class_name": "WorkspaceContainer"
			},
			{
				"name": "WorkspaceCatalog",
				"class_name": "WorkspaceCatalog"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Pim"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Auth"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"Directory"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"Gallery"
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": [
				"CodingSchedulerDO"
			]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": [
				"CodingThreadDO"
			]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": [
				"HostOps"
			]
		},
		{
			"tag": "v8",
			"new_sqlite_classes": [
				"WorkspaceContainer",
				"WorkspaceCatalog"
			]
		}
	],
	"containers": [
		{
			"name": "coding-workspaces",
			"class_name": "WorkspaceContainer",
			"scheduling_policy": "durable_object",
			"images": {
				"base": {
					"dockerfile": "../../../../workspace-agentd/Dockerfile",
					"build_context": "../../../../workspace-agentd",
					"build_vars": {
						"FLAVOR": "cloudflare"
					}
				}
			}
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV"
		}
	],
	"r2_buckets": [
		{
			"binding": "BLOBS"
		},
		{
			"binding": "ARTIFACTS"
		}
	],
	"keep_vars": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true
	},
	"vars": {}
}
