{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024"
		],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": [
			"node"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"src/fence-worker/**",
		"test/fence.test.ts"
	]
}
