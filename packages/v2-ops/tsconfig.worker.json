{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": ["node", "../../workerd-runtime.d.ts", "./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/fence-worker/**/*.ts", "test/fence.test.ts", "test/raw.d.ts"]
}
