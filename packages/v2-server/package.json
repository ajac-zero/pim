{
  "name": "@pim/v2-server",
  "version": "0.1.0",
  "description": "Pim v2's integration layer: what joins the runtime, Live and the other workstreams into one deployment, with the migrations that span them and the tests that run them together against real PostgreSQL and NATS.",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --import tsx src/main.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@pim/coding": "workspace:*",
    "@pim/shared": "workspace:*",
    "@pim/v2-app": "workspace:*",
    "@pim/v2-contracts": "workspace:*",
    "@pim/v2-forge": "workspace:*",
    "@pim/v2-live": "workspace:*",
    "@pim/v2-ops": "workspace:*",
    "@pim/v2-runtime": "workspace:*",
    "pg": "^8.16.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "s3rver": "^3.7.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
