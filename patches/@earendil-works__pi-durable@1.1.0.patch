+/**
+ * Suspend the call: commit it `waiting` on no task, at its `execute` phase, so `Harness.resumeTask()` makes it pending
+ * and the tool runs again as on recovery. No result entry is written; the slot keeps what the call reported so far.
+ */
+async function suspend(runtime, args, progress, context, end) {
+    end();
+    const pending = await progress.stop();
+    try {
+        await runtime.commit(async () => ({
+            status: "waiting",
+            checkpoint: { phase: "execute", arguments: args, replay: "safe" },
+            on: [],
+            policy: "allSettled",
+        }), context);
+    }
+    catch (error) {
+        for (const waiter of pending)
+            waiter.reject(error);
+        throw error;
+    }
+    for (const waiter of pending)
+        waiter.resolve();
