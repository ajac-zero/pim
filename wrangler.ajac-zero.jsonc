// The owner's Pim at pim.ajac-zero.com: `pnpm run deploy:ajac-zero`. Notes in
// docs/deployments/ajac-zero.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pim",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pim.ajac-zero.com", "custom_domain": true }],
  "build": { "command": "pnpm --filter pim-web build", "watch_dir": "web/src" },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth/*", "/health", "/mcp/callback/*", "/mcp/events/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "Pim", "class_name": "Pim" },
      { "name": "Auth", "class_name": "Auth" },
      { "name": "Directory", "class_name": "Directory" },
      { "name": "Gallery", "class_name": "Gallery" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pim"] },
    { "tag": "v2", "new_sqlite_classes": ["Auth"] },
    { "tag": "v3", "new_sqlite_classes": ["Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["Gallery"] }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "71420101", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "71420102", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "PIM_MODEL": "@cf/zai-org/glm-4.7-flash",
    "PIM_TIME_ZONE": "UTC",
    "PIM_WEB_SEARCH": "",
    "PIM_MEMORY_MODEL": "",
    "PIM_MEMORY_LINES": "",
    "PIM_PUBLIC_URL": "https://pim.ajac-zero.com",
    "PIM_APPROVAL_POLICY": "explicit",
    "PIM_MODELS": "@cf/zai-org/glm-4.7-flash",
    "PIM_LIMITS": "{\"dailyTokens\": 300000, \"dailyModelRequests\": 300, \"dailyRuns\": 100, \"sessions\": 100, \"schedules\": 20, \"apps\": 10, \"storageBytes\": 200000000, \"artifacts\": 100, \"artifactVersions\": 50, \"artifactBytes\": 500000, \"artifactStorageBytes\": 10000000}",
    "PIM_REGISTRATION": "invite",
    "PIM_MAX_ACCOUNTS": "25",
    "PIM_REGISTRATIONS_PER_ADDRESS": "3"
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
