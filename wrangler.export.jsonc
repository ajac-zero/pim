      },
      {
        "name": "Auth",
        "class_name": "Auth"
      },
      {
        "name": "Directory",
        "class_name": "Directory"
      },
      {
        "name": "Gallery",
        "class_name": "Gallery"
      },
      {
        "name": "CodingScheduler",
        "class_name": "CodingSchedulerDO"
      },
      {
        "name": "CodingThread",
        "class_name": "CodingThreadDO"
      },
      {
        "name": "HostOps",
        "class_name": "HostOps"
      },
      {
        "name": "WorkspaceContainer",
        "class_name": "WorkspaceContainer"
      },
      {
        "name": "WorkspaceCatalog",
        "class_name": "WorkspaceCatalog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Pim"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Auth"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "Directory"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "Gallery"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "CodingSchedulerDO"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "CodingThreadDO"
      ]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": [
        "HostOps"
      ]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": [
        "WorkspaceContainer",
        "WorkspaceCatalog"
      ]
    }
  ],
  "containers": [
    {
      "name": "coding-workspaces",
      "class_name": "WorkspaceContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./workspace-agentd/Dockerfile",
          "build_context": "./workspace-agentd",
          "build_vars": {
            "FLAVOR": "cloudflare"
          }
        }
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS"
    },
    {
      "binding": "ARTIFACTS"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
