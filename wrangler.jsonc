{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pim",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // Served from custom domains only.
  "workers_dev": false,
  "preview_urls": false,
  // The web app, built from web/ before every `wrangler dev` and `wrangler deploy`.
  "build": { "command": "pnpm --filter pim-web build", "watch_dir": "web/src" },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is the app's pages and files.
    "run_worker_first": ["/api", "/api/*", "/auth/*", "/health", "/mcp/callback/*", "/mcp/events/*"]
  },
  // Workers AI runs the model; under `wrangler dev` it calls your logged-in account.
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      // Everyone's agent, one per person, named by their owner ID.
      { "name": "Pim", "class_name": "Pim" },
      // Each person's passkeys, recovery codes and API tokens.
      { "name": "Auth", "class_name": "Auth" },
      // The accounts: usernames, the admin, invites, and erasing deleted accounts.
      { "name": "Directory", "class_name": "Directory" },
      // Profiles, and Pims published for others on this Pim to make their own.
      { "name": "Gallery", "class_name": "Gallery" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pim"] },
    { "tag": "v2", "new_sqlite_classes": ["Auth"] },
    { "tag": "v3", "new_sqlite_classes": ["Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["Gallery"] }
  ],
  // Slow down guessing at sign-in from one address, and heavy API use by one person.
  // Namespace IDs are positive integers unique in your Cloudflare account.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "71420101", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "71420102", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    // Any Workers AI id (`@cf/...`) or AI Gateway catalog id (`anthropic/...`). The default is
    // the free try-it model: fine for a first look, not for real use. Set a capable model here,
    // or connect a ChatGPT plan in Settings.
    "PIM_MODEL": "@cf/zai-org/glm-4.7-flash",
    // IANA time zone for anyone who hasn't set theirs; registering sets the browser's.
    "PIM_TIME_ZONE": "UTC",
    // Set to "exa", "ceramic" or "linkup" to enable web_search (billed by AI Gateway).
    "PIM_WEB_SEARCH": "",
    // Model that compresses long-term memory; empty uses PIM_MODEL (never the ChatGPT plan).
    "PIM_MEMORY_MODEL": "",
    // Lines of long-term memory in every prompt; empty is 96 (about 8k tokens).
    "PIM_MEMORY_LINES": "",
    // This deployment's public URL, for app event callbacks; empty learns it from API requests.
    "PIM_PUBLIC_URL": "",
    // What an approval nobody answers becomes: "auto" approves it after 30 seconds; "explicit"
    // waits for an answer however long. Each person can change theirs in Settings.
    "PIM_APPROVAL_POLICY": "auto",
    // Platform models sessions may use besides PIM_MODEL, comma-separated; empty allows any.
    "PIM_MODELS": "",
    // Usage limits for members as JSON, such as {"dailyTokens": 2000000, "dailyRuns": 500};
    // empty is none. The admin has none. See src/usage.ts for every limit.
    "PIM_LIMITS": "",
    // How people join once there is an admin: "invite" (links the admin makes), "open" or "closed".
    "PIM_REGISTRATION": "invite",
    // Accounts allowed in all; empty for no cap.
    "PIM_MAX_ACCOUNTS": "",
    // Registrations one IP address may make in a day; empty is 3.
    "PIM_REGISTRATIONS_PER_ADDRESS": ""
  },
  // When this version was deployed: whoever opens a Pim with no admin in the 15 minutes
  // after becomes its admin.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers Logs: where setup links show up, to claim a Pim or for the admin's lost passkey.
  "observability": { "enabled": true }
}
