{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pim",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // A new deployment is reachable at its workers.dev address until it has a custom domain.
  "workers_dev": true,
  "preview_urls": false,
  // The web app, built from web/ before every `wrangler dev` and `wrangler deploy`.
  "build": { "command": "pnpm --filter pim-web build", "watch_dir": "web/src" },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is the app's pages and files.
    "run_worker_first": ["/api", "/api/*", "/install.sh", "/auth/*", "/health", "/mcp", "/oauth/*", "/.well-known/*", "/authorize", "/mcp/callback/*", "/mcp/client/*", "/mcp/events/*", "/images/*", "/shared/*", "/app-pages/*", "/hosted/*", "/p/*"]
  },
  // Workers AI runs the model; under `wrangler dev` it calls your logged-in account. Optional:
  // delete this line to run without it, and people use the model providers they add in Settings.
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      // Each person's space, one per person, named by their owner ID.
      { "name": "Pim", "class_name": "Pim" },
      // Each person's passkeys, recovery codes and API tokens.
      { "name": "Auth", "class_name": "Auth" },
      // The accounts: usernames, the admin, invites, and erasing deleted accounts.
      { "name": "Directory", "class_name": "Directory" },
      // Profiles, and agents published for others on this Pim to make their own.
      { "name": "Gallery", "class_name": "Gallery" },
      // Each space's coding scheduler: the queue for its coding workspaces' slots, named by its owner ID.
      { "name": "CodingScheduler", "class_name": "CodingSchedulerDO" },
      // Each coding thread: its agent loop, transcript, checkpoints and spend, named by the thread's ID.
      { "name": "CodingThread", "class_name": "CodingThreadDO" },
      // Host operations: the queue and audit log of what the admin's majordomo asks of this Pim's host, one for the deployment.
      { "name": "HostOps", "class_name": "HostOps" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pim"] },
    { "tag": "v2", "new_sqlite_classes": ["Auth"] },
    { "tag": "v3", "new_sqlite_classes": ["Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["Gallery"] },
    { "tag": "v5", "new_sqlite_classes": ["CodingSchedulerDO"] },
    { "tag": "v6", "new_sqlite_classes": ["CodingThreadDO"] },
    { "tag": "v7", "new_sqlite_classes": ["HostOps"] }
  ],
  // MCP clients' sign-ins to people's spaces: registered clients, grants and hashed tokens
  // (src/mcp-auth.ts). Deploying creates the namespace.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // What each space keeps outside its database, under its owner's ID: images people send in
  // chats (their messages keep only the images' URLs), skills' files (src/skills.ts), and files
  // that aren't text from before people's files moved to their computers (src/legacy-files.ts), in one bucket; apps' files (src/artifacts.ts) in another. Deploying
  // creates the buckets, once R2 is turned on for the account (Dashboard → R2; it asks for a
  // payment method).
  "r2_buckets": [{ "binding": "BLOBS" }, { "binding": "ARTIFACTS" }],
  // Slow down guessing at sign-in from one address, and heavy API use by one person.
  // Namespace IDs are positive integers unique in your Cloudflare account.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "71420101", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "71420102", "simple": { "limit": 600, "period": 60 } }
  ],
  // How a Pim runs (its address, who may join, its models, members' limits, who answers approvals)
  // is each deployment's own, so it isn't here: set those variables in the dashboard (Workers & Pages
  // → pim → Settings → Variables and Secrets), and this keeps them through deploys. All but the
  // address, PIM_PUBLIC_URL, have a default in src/deployment.ts; docs/reference.md lists them, and the
  // admin sees them in Settings → Deployment. OpenTelemetry traces are set the same way: see Traces
  // in docs/reference.md.
  "keep_vars": true,
  // Signing in with Google, GitHub or your own OpenID Connect provider, besides passkeys, is off
  // until you add an OAuth app's client ID and secret as secrets (dashboard → Workers & Pages →
  // pim → Settings → Variables and Secrets, or `wrangler secret put`). The app's callback URL is
  // shown in Settings.
  //   Google:  PIM_GOOGLE_CLIENT_ID, PIM_GOOGLE_CLIENT_SECRET
  //   GitHub:  PIM_GITHUB_CLIENT_ID, PIM_GITHUB_CLIENT_SECRET
  //   OIDC:    PIM_OIDC_ISSUER (such as https://auth.example.com), PIM_OIDC_CLIENT_ID,
  //            PIM_OIDC_CLIENT_SECRET, and optionally PIM_OIDC_NAME, its button's name
  // Email to each person, off until set up: onboard a domain to Cloudflare Email Service,
  // uncomment this, and set PIM_EMAIL_FROM to an address on that domain.
  // "send_email": [{ "name": "EMAIL" }],
  // When this version was deployed: whoever opens a Pim with no admin in the 15 minutes
  // after becomes its admin.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers Logs: where setup links show up, to claim a Pim or for the admin's lost passkey.
  "observability": { "enabled": true },
  // What `wrangler preview` (Workers Builds' Preview builds) runs: Previews don't inherit the
  // settings above. Durable Objects get a new namespace and storage for each Preview, so their
  // classes and migrations stay at the top level and only the bindings are repeated, as are the
  // bindings that need no resource. The ratelimits take their own namespace IDs.
  // OAUTH_KV, BLOBS and ARTIFACTS are left out on purpose: a Preview's KV and R2 bindings are
  // bound by namespace ID and bucket name, never made for it, and repeating production's would
  // share its data. Until test resources are added here, a Preview runs without them.
  "previews": {
    "ai": { "binding": "AI" },
    "durable_objects": {
      "bindings": [
        { "name": "Pim", "class_name": "Pim" },
        { "name": "Auth", "class_name": "Auth" },
        { "name": "Directory", "class_name": "Directory" },
        { "name": "Gallery", "class_name": "Gallery" },
        { "name": "HostOps", "class_name": "HostOps" }
      ]
    },
    "ratelimits": [
      { "name": "AUTH_LIMITER", "namespace_id": "71420201", "simple": { "limit": 30, "period": 60 } },
      { "name": "API_LIMITER", "namespace_id": "71420202", "simple": { "limit": 600, "period": 60 } }
    ],
    "version_metadata": { "binding": "CF_VERSION_METADATA" }
  }
}
