// A Pim on your own machine, for trying the web app: `pnpm preview`. Never deploy it: it has
// open registration, no rate limits, a stand-in model and a sign-in route that needs no passkey
// (see preview/worker.ts), so it needs no Cloudflare account. Its state is kept in
// .wrangler/state-preview.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pim-preview",
  "main": "preview/worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // The web app, rebuilt whenever web/src changes.
  "build": { "command": "pnpm --filter pim-web build", "watch_dir": "web/src" },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth/*", "/health", "/mcp", "/oauth/*", "/.well-known/*", "/authorize", "/mcp/callback/*", "/mcp/client/*", "/mcp/events/*", "/images/*", "/__dev/*"]
  },
  // Pim needs an `AI` binding to start; chats use preview/worker.ts's stand-in model instead.
  // Connect a ChatGPT plan in Settings to chat with a real one.
  "kv_namespaces": [
    { "binding": "AI", "id": "preview-ai-stand-in" },
    { "binding": "OAUTH_KV", "id": "preview-oauth" }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "pim-preview-images" }],
  // The agents' browser: a Chrome on this machine, which wrangler downloads the first time.
  "browser": { "binding": "BROWSER" },
  // Runs agents' code (`run_javascript`), as deployments on the Workers Paid plan can.
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "Pim", "class_name": "Pim" },
      { "name": "Auth", "class_name": "Auth" },
      { "name": "Directory", "class_name": "Directory" },
      { "name": "Gallery", "class_name": "Gallery" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pim"] },
    { "tag": "v2", "new_sqlite_classes": ["Auth"] },
    { "tag": "v3", "new_sqlite_classes": ["Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["Gallery"] }
  ],
  // Only what differs from the defaults in src/deployment.ts.
  "vars": {
    "PIM_PUBLIC_URL": "http://localhost:8787",
    "PIM_REGISTRATION": "open",
    "PIM_REGISTRATIONS_PER_ADDRESS": "50",
    "PIM_MODELS": "preview-model",
    "PIM_LIMIT_DAILY_TOKENS": "2000000",
    "PIM_LIMIT_DAILY_MODEL_REQUESTS": "1500",
    "PIM_LIMIT_DAILY_RUNS": "300",
    "PIM_LIMIT_SESSIONS": "500",
    "PIM_LIMIT_SCHEDULES": "50",
    "PIM_LIMIT_STORAGE_BYTES": "1000000000",
    "PIM_LIMIT_ARTIFACTS": "200",
    "PIM_LIMIT_ARTIFACT_VERSIONS": "100",
    "PIM_LIMIT_ARTIFACT_BYTES": "1000000",
    "PIM_LIMIT_ARTIFACT_STORAGE_BYTES": "10000000"
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
