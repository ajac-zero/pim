{
  // Local preview of Pimling only: `pnpm preview:hosted`, then open http://pimling.localhost:8787.
  // Never deploy this: it has no routes, a stand-in for Workers AI, open registration and a
  // known admin token. It uses no remote bindings, so it touches no Cloudflare account.
  // Keep its bindings and migrations in step with wrangler.hosted.jsonc.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pimling-preview",
  "main": "src/hosted/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth/*", "/admin/*", "/health", "/mcp/callback", "/mcp/events/*"]
  },
  // Workers AI needs a Cloudflare account, so the platform model can't answer here: chats on it
  // end with an error. Connect a ChatGPT plan in Settings to chat for real.
  "kv_namespaces": [{ "binding": "AI", "id": "preview-ai-stand-in" }],
  "durable_objects": {
    "bindings": [
      { "name": "Pim", "class_name": "Pim" },
      { "name": "Auth", "class_name": "Auth" },
      { "name": "Directory", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pim"] },
    { "tag": "v2", "new_sqlite_classes": ["Auth"] },
    { "tag": "v3", "new_sqlite_classes": ["Directory"] }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    // Browsers resolve every *.localhost name to this machine: alice.pimling.localhost works as is.
    "PIMLING_DOMAIN": "pimling.localhost",
    "PIMLING_REGISTRATION": "open",
    "PIMLING_MAX_ACCOUNTS": "",
    "PIMLING_REGISTRATIONS_PER_ADDRESS": "50",
    // The admin API, for this preview only.
    "PIMLING_ADMIN_TOKEN": "preview-admin",
    "PIM_MODEL": "@cf/zai-org/glm-4.7-flash",
    "PIM_TIME_ZONE": "UTC",
    "PIM_APPROVAL_POLICY": "explicit",
    "PIM_MODELS": "@cf/zai-org/glm-4.7-flash",
    "PIM_WEB_SEARCH": "",
    "PIM_MEMORY_MODEL": "",
    "PIM_MEMORY_LINES": "",
    "PIM_PUBLIC_URL": "",
    "PIM_LIMITS": "{\"dailyTokens\": 2000000, \"dailyModelRequests\": 1500, \"dailyRuns\": 300, \"sessions\": 500, \"schedules\": 50, \"apps\": 20, \"storageBytes\": 1000000000, \"artifacts\": 200, \"artifactVersions\": 100, \"artifactBytes\": 1000000, \"artifactStorageBytes\": 10000000}"
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
