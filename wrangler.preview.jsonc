// A Pim on your own machine, for trying the web app: `pnpm preview`. Never deploy it: it has
// open registration and no rate limits, and it binds a stand-in for Workers AI, so it needs no
// Cloudflare account. Its state is kept in .wrangler/state-preview.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pim-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth/*", "/health", "/mcp/callback/*", "/mcp/events/*", "/images/*"]
  },
  // Workers AI needs an account: chats on the platform model end with a model error. Connect a
  // ChatGPT plan in Settings to chat for real.
  "kv_namespaces": [{ "binding": "AI", "id": "preview-ai-stand-in" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "pim-preview-images" }],
  "durable_objects": {
    "bindings": [
      { "name": "Pim", "class_name": "Pim" },
      { "name": "Auth", "class_name": "Auth" },
      { "name": "Directory", "class_name": "Directory" },
      { "name": "Gallery", "class_name": "Gallery" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pim"] },
    { "tag": "v2", "new_sqlite_classes": ["Auth"] },
    { "tag": "v3", "new_sqlite_classes": ["Directory"] },
    { "tag": "v4", "new_sqlite_classes": ["Gallery"] }
  ],
  "vars": {
    "PIM_MODEL": "@cf/zai-org/glm-5.3",
    "PIM_TIME_ZONE": "UTC",
    "PIM_WEB_SEARCH": "",
    "PIM_MEMORY_MODEL": "",
    "PIM_MEMORY_LINES": "",
    "PIM_PUBLIC_URL": "",
    "PIM_APPROVAL_POLICY": "explicit",
    "PIM_MODELS": "@cf/zai-org/glm-4.7-flash",
    "PIM_LIMITS": "{\"dailyTokens\": 2000000, \"dailyModelRequests\": 1500, \"dailyRuns\": 300, \"sessions\": 500, \"schedules\": 50, \"apps\": 20, \"storageBytes\": 1000000000, \"artifacts\": 200, \"artifactVersions\": 100, \"artifactBytes\": 1000000, \"artifactStorageBytes\": 10000000}",
    "PIM_REGISTRATION": "open",
    "PIM_MAX_ACCOUNTS": "",
    "PIM_REGISTRATIONS_PER_ADDRESS": "50"
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
